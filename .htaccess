# Rendimiento: compresión y caché del navegador (solo si el servidor tiene los módulos)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# SEO: robots, sitemap y feed de Google Merchant Center
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Una sola versión del sitio: sin www y con https (301)
  RewriteCond %{HTTP_HOST} ^www\.alquimia-digital\.cl$ [NC]
  RewriteRule ^ https://alquimia-digital.cl%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^alquimia-digital\.cl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://alquimia-digital.cl%{REQUEST_URI} [R=301,L]
  # La portada se muestra siempre en la raíz: /index.php -> / (solo si el visitante pidió index.php de forma explícita)
  RewriteCond %{THE_REQUEST} \s/index\.php[\s?]
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^feed\.xml$ feed.php [L]

  # URLs antiguas de Shopify -> páginas equivalentes de esta tienda (redirección permanente)
  # Prefijo de idioma/mercado de Shopify (/es-mx/products/...) -> misma ruta sin prefijo
  RewriteRule ^(?:es-[a-z]{2}|en(?:-[a-z]{2})?)/(.*)$ /$1 [R=301,L]
  # Inicio de sesión de Shop y otros servicios de Shopify: ya no existen (410 = eliminada para siempre)
  RewriteRule ^(services|cdn/shop|apps|account|checkouts)(/|$) - [G,L]
  RewriteRule ^products/([^/]+)/?$ producto.php?handle=$1 [QSA,L]
  RewriteRule ^collections/(autodesk|adobe|windows|antivirus)/?$ catalogo.php?cat=$1 [R=301,L]
  RewriteRule ^collections/(office|office-365|office-365-1)/?$ catalogo.php?cat=office [R=301,L]
  RewriteRule ^collections(/.*)?$ catalogo.php? [R=301,L]
  RewriteRule ^cart/?$ carrito.php? [R=301,L]
  RewriteRule ^pages/(contact|contacto)[^/]*/?$ contacto.php? [R=301,L]
  RewriteRule ^pages/.*$ contacto.php? [R=301,L]
  RewriteRule ^policies/refund-policy/?$ legal.php?p=reembolso [R=301,L]
  RewriteRule ^policies/privacy-policy/?$ legal.php?p=privacidad [R=301,L]
  RewriteRule ^policies/terms-of-service/?$ legal.php?p=terminos [R=301,L]
  RewriteRule ^policies/shipping-policy/?$ legal.php?p=envios [R=301,L]
  RewriteRule ^blogs/.*$ index.php? [R=301,L]
</IfModule>
# Páginas internas que no deben indexarse
<IfModule mod_headers.c>
  <FilesMatch "^(carrito|portal|confirmar-pago|pedido-resultado|checkout-create-preference|cron-expirar|resena)\.php$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
